\name{jwcalendarR-package}
\alias{jwcalendarR-package}
\alias{jwcalendarR}
\title{Structural Calendar Analysis and Temporal Validation}
\description{
Provides a timezone-free civil-date model, calendar-structure signatures, finite-domain date-rule compilation, selected-date set operations, and temporal boundary and drift diagnostics.
}
\details{
The first release is a pure R reference implementation. It is designed for transparent finite-domain analysis and validation rather than timestamp, time-zone, holiday-database, or general interval processing.
}
\seealso{civil-dates, calendar-structure, rule-compilation, calendar-validation}
\keyword{package}
